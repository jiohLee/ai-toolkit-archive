{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comment",
  "type": "object",
  "required": ["id", "category", "result", "title", "rule", "reason", "severity", "line", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "category": { "type": "string", "minLength": 1 },
    "result": { "enum": ["edit", "note"] },
    "title": { "type": "string", "minLength": 1 },
    "rule": { "type": "string" },
    "reason": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["required", "optional"] },
    "minus": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "plus": { "type": "array", "items": { "type": "string" } },
    "quote": { "type": "string", "minLength": 1 },
    "line": { "type": "integer", "minimum": 1 },
    "decision": { "enum": ["apply", "keep"] },
    "instruction": { "type": "string" },
    "status": { "enum": ["pending", "kept", "applied"] }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "edit" } } },
      "then": { "required": ["minus", "plus"] }
    },
    {
      "if": { "properties": { "result": { "const": "note" } } },
      "then": { "required": ["quote"] }
    },
    {
      "if": { "properties": { "severity": { "const": "required" } } },
      "then": { "properties": { "rule": { "minLength": 1 } } }
    }
  ]
}
